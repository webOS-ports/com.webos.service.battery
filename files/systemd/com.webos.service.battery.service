[Unit]
Description=Daemon to manage charging and battery monitoring
# nyx.target is the ordering point for everything that reads /etc/nyx.conf:
# luneos-device-config generates that file at boot and binds it in place
# Before=nyx.target. batteryd opens the nyx charger module at startup, and
# without this ordering it raced the generator and read the shipped
# placeholder - on sargo that meant the charger sysfs path fell back to nyx's
# own walk, which picks the wrong supply, and USB charging was never detected.
After=activitymanager.service nyx.target
# Wants, not Requires: with Requires, every stop of activitymanager (a package
# upgrade restarts it) stopped batteryd as well, and Restart=on-failure does
# not bring back a unit that was stopped cleanly. Seen on sargo and tissot on
# 2026-09-19: batteryd gone for hours, so no charger edge reached the display
# manager (screen stayed on after unplug under onWhenConnected) or sleepd.
# batteryd does not call activitymanager; the ordering is all it needs.
Wants=activitymanager.service

[Service]
Type=simple
Restart=on-failure
# TODO: check wether the lines below are required anymore
Environment=CONF_DIR=/var/preferences/com.webos.service.battery CONF_FILE=${CONF_DIR}/com.webos.service.battery.conf DEFAULT_CONF_FILE=/etc/default/com.webos.service.battery.conf TMP_FILE=${CONF_DIR}/com.webos.service.battery.tmp
ExecStartPre=-/bin/sh -c 'mkdir -p ${CONF_DIR}'
ExecStartPre=-/bin/sh -c 'cp ${DEFAULT_CONF_FILE} ${TMP_FILE}'
ExecStartPre=-/bin/sh -c 'sync'
ExecStartPre=-/bin/sh -c 'mv ${TMP_FILE} ${CONF_FILE}'
ExecStart=/usr/sbin/batteryd

[Install]
WantedBy=multi-user.target
